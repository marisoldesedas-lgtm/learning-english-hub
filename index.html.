    <script>
        // Mobile Menu Toggle
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Checklist State Persistence with LocalStorage
        function saveChecklistState() {
            const checkboxes = document.querySelectorAll('.roadmap-checkbox');
            const state = [];
            checkboxes.forEach((cb, idx) => {
                state.push(cb.checked);
            });
            localStorage.setItem('english_project_checklist', JSON.stringify(state));
            updateChecklistUI();
        }

        function loadChecklistState() {
            const saved = localStorage.getItem('english_project_checklist');
            if(saved) {
                const state = JSON.parse(saved);
                state.forEach((val, idx) => {
                    const cb = document.getElementById(`step-${idx}`);
                    if(cb) cb.checked = val;
                });
            }
            updateChecklistUI();
        }

        function resetChecklist() {
            localStorage.removeItem('english_project_checklist');
            const checkboxes = document.querySelectorAll('.roadmap-checkbox');
            checkboxes.forEach(cb => cb.checked = false);
            updateChecklistUI();
        }

        function updateChecklistUI() {
            const checkboxes = document.querySelectorAll('.roadmap-checkbox');
            let checkedCount = 0;
            checkboxes.forEach(cb => {
                if(cb.checked) checkedCount++;
            });
            const percent = Math.round((checkedCount / 11) * 100);
            
            document.getElementById('dashboard-progress-bar').style.width = percent + '%';
            document.getElementById('dashboard-progress-text').innerText = `${percent}% (${checkedCount}/11 completed)`;
        }

        // Audio Player Simulation
        let isAudioPlaying = false;
        function toggleAudioPlay() {
            isAudioPlaying = !isAudioPlaying;
            const icon = document.getElementById('audioPlayIcon');
            if(isAudioPlaying) {
                icon.className = "fa-solid fa-pause";
                showToast("Audio playback started (simulated stream).");
            } else {
                icon.className = "fa-solid fa-play ml-0.5";
                showToast("Audio playback paused.");
            }
        }

        function resetAudio() {
            isAudioPlaying = false;
            document.getElementById('audioPlayIcon').className = "fa-solid fa-play ml-0.5";
            document.getElementById('audio-progress').style.width = "0%";
            document.getElementById('audio-current-time').innerText = "00:00";
            showToast("Audio reset to beginning.");
        }

        function seekAudio(e) {
            const rect = e.currentTarget.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            document.getElementById('audio-progress').style.width = (pos * 100) + '%';
            const currentSecs = Math.floor(pos * 255);
            const mins = Math.floor(currentSecs / 60);
            const secs = currentSecs % 60;
            document.getElementById('audio-current-time').innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }

        // Interactive Quiz Engine
        const quizQuestions = [
            {
                question: "1. Which option correctly completes the sentence: 'If I _____ harder, I would have passed the exam.'",
                options: ["A) study", "B) had studied", "C) would study"],
                correct: 1,
                explanation: "Correct! This is a Third Conditional sentence expressing a hypothetical past condition: 'If I had studied harder, I would have passed.'"
            },
            {
                question: "2. What does the phrasal verb 'look up' mean in academic research?",
